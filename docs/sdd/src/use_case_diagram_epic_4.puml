@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle outline

actor "Candidate" as candidate
actor "Hiring Manager" as manager
actor "Execution Sandbox" as sandbox << External System >>

rectangle "ANA Subsystem (Candidate Analytics & Evaluation)" {
    usecase "UC-ANA-01: Stream & Ingest IDE Telemetry" as UC1
    usecase "UC-ANA-02: Calculate Execution Efficiency Metrics" as UC2
    usecase "UC-ANA-03: Calculate Technical Pass Rate Score" as UC3
    usecase "UC-ANA-04: Evaluate Integrity Risk" as UC4
    usecase "UC-ANA-05: Export Candidate Evaluation Report" as UC5
}

' Primary Actor Associations
candidate --> UC1
candidate --> UC2
manager --> UC5

' External System Associations
sandbox --> UC2
sandbox --> UC3

' Internal Dependencies & Triggers
UC1 .> UC4 : <<triggers>>
UC5 .> UC2 : <<include>>
UC5 .> UC3 : <<include>>
UC5 .> UC4 : <<include>>

@enduml

@startuml
title 2/10 - Epic JOB: Jobs, Search & Integrations
skinparam componentStyle rectangle
left to right direction
skinparam component {
  BackgroundColor<<foreign>> #EEEEEE
  BorderColor<<foreign>> #999999
  FontColor<<foreign>> #555555
}

component "Jobs, Search & Integrations" as JOB {
  component "Posting Editor" as PED
  component "Employer Language Switcher" as LNG
  component "Hiring Configuration" as HCF
  component "Posting Tags" as TAG
  component "Posting Lifecycle Manager" as PLM
  component "Banned Company Handler" as BCH
  component "Company Posting List" as CPL
  component "Jobs Feed" as FED
  component "Filtering, Sorting & Search" as FSS
  component "Posting Details" as PDT
  component "Saved Jobs" as SVJ
  component "Company Following" as CFM
  component "Recommendations" as RCM
  component "Saved Searches & New-Jobs Tracker" as SST
  component "Posting Sharing" as SHR
  component "Application Submission" as APP
  component "Screening & Admission" as SCR
}

' ---------- Neighbouring epics (stubs, grey) ----------
component "Candidates (CAND)" as CAND <<foreign>> {
  component "Job Discovery & Filtering" as JDF <<foreign>>
  component "Saved Postings" as SVP <<foreign>>
  component "Company Follow Manager" as CFL <<foreign>>
  component "Application History & Status" as APH <<foreign>>
  component "Dynamic Resume Generator" as DRG <<foreign>>
}
component "Accounts, Identity & Trust (AUTH)" as AUTH <<foreign>> {
  component "Company Registration & Verification" as CRV <<foreign>>
  component "Taxonomy & Constants Manager" as TAX <<foreign>>
  component "User & Account Administration" as UMG <<foreign>>
  component "Authentication & Session Manager" as LGN <<foreign>>
  component "Public Company Profile" as PCP <<foreign>>
  component "Profile Management" as PRF <<foreign>>
  component "Entity Administration" as EMG <<foreign>>
  component "Admin Reports & Statistics" as ARP <<foreign>>
  component "Access Control (RBAC)" as RBAC <<foreign>>
}
component "Pipeline & Interviews & Tests (INVW)" as INVW <<foreign>> {
  component "Pipeline Versioning & Migration" as PVM <<foreign>>
  component "Pipeline Dashboard & Insights" as PDI <<foreign>>
  component "Finalists & Offers Manager" as FOM <<foreign>>
  component "Test Execution & Scoring" as TES <<foreign>>
  component "Live Interview Manager" as LIM <<foreign>>
  component "Stage Advancement Engine" as SAE <<foreign>>
  component "Anonymity Manager" as ANM <<foreign>>
}
component "Email Service" as ES <<external>>

interface "IPostingData" as IPO
interface "IAccessControl" as IAC
RBAC -- IAC
HCF -- IPO

' ---------- JOB internal dependencies ----------
PED ..> HCF : content & hiring configuration (FR-JOB-008)
PED ..> TAG : tags
PLM ..> PED : draft content, language & currency checks
PLM ..> HCF : mandatory fields & dates
BCH --> PLM : archive / resume postings of banned company
CPL ..> PLM : all company postings, any state
FED ..> PLM : Published postings
FED ..> FSS : same filters & sorting
FED ..> RCM : Recommended ordering
FED ..> CFM : followed-companies limit
FED ..> SVJ : saved marks
FED ..> APP : applied marks
FSS ..> PLM : Published postings
PDT ..> PLM : posting state
PDT ..> HCF : dates, criteria, openings, salary
PDT ..> APP : can the candidate apply
PDT ..> SVJ : save action
PDT ..> CFM : follow action
SVJ ..> PLM : posting availability
CFM ..> PLM : new postings published
RCM ..> PLM : posting data & tags
SST ..> FSS : saved filters
SST ..> PLM : new postings published
SHR ..> PDT : opens detail page
APP ..> HCF : questions, dates, application cap
APP ..> PLM : posting state (open / archived)
SCR ..> APP : accepted submissions
SCR ..> HCF : Must-have criteria

' ---------- JOB to external systems ----------
PED ..> ES : posting-change emails
PLM ..> ES : archive / republish emails
BCH ..> ES : ban emails (no reason stated)
CFM ..> ES : new-posting emails
SST ..> ES : tracker emails
SVJ ..> ES : deadline reminders
APP ..> ES : confirmation email
SCR ..> ES : screened-out notice

' ---------- JOB to other epics ----------
PED ..> CRV : verified company required
PED ..> TAX : standard languages & currencies
TAG ..> TAX : tag taxonomy
BCH ..> UMG : ban / ban-resolved events
PLM ..> UMG : company deactivated status
FED ..> LGN : sign-in gate (FR-JOB-047)
SHR ..> LGN : sign-in redirect
FSS ..> PCP : company search results
RCM ..> PRF : job preferences
APP ..> DRG : resume completeness & snapshot
SCR --> PVM : admitted applications (start at entry stages)

' ---------- Incoming from other epics ----------
JDF ..> FED : feed & posting essentials
JDF ..> FSS : filtering & search
SVP ..> SVJ : saved postings
CFL ..> CFM : follow / unfollow, followed list
APH ..> APP : submitted applications
PCP ..> PLM : Published postings of company
PCP ..> CFM : follow from company profile
EMG ..> PED : admin edits postings
EMG ..> PLM : admin archive / republish / delete
ARP ..> PLM : aggregate posting data
TES ..> PLM : archived posting suspends tests
LIM ..> PLM : archived posting blocks booking
SAE ..> PLM : archived posting blocks decisions
ANM ..> APP : masks submitted resume copies (assumed)
PVM ..> IPO : application deadline
PDI ..> IPO : finalist target (not yet defined in JOB)
FOM ..> IPO : job title & open-position capacity

JOB ..> IAC : roles & permissions
@enduml

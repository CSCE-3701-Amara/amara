@startuml

' Diagram Configuration
left to right direction
skinparam ranksep 500
skinparam shadowing false

' Defining Actors
actor Candidate
actor Interviewer
actor Guest
actor "Hiring Manager" as HM
actor "System Administrator" as SA
actor System

' Defining INVW Use Cases
rectangle "INVW" {
	usecase "Design pipeline" as UC001
	usecase "Configure assessment module" as UC002
	usecase "Create custom test" as UC003
	usecase "Conduct live interview" as UC004
	usecase "Version and migrate pipeline" as UC005
	usecase "Advance or reject candidate" as UC006
	usecase "Review dashboard and insights" as UC007
	usecase "Configure candidate anonymity" as UC008
	usecase "Manage feedback and notifications" as UC009
	usecase "Execute and score assessment" as UC010
	usecase "Use LLM-paired programming" as UC013
	usecase "View candidate pipeline progress" as UC014
	usecase "Configure Amara definitions" as UC015
	usecase "Award and view Amarat" as UC016
}

UC001 -- HM
UC002 -- HM
UC003 -- HM
UC005 -- HM
UC006 -- HM
UC007 -- HM
UC008 -- HM
UC009 -- HM
UC015 -- HM
UC016 -- HM

UC004 -- Interviewer
UC009 -- Interviewer

Candidate -- UC004
Candidate -- UC009
Candidate -- UC010
Candidate -- UC013
Candidate -- UC014
Candidate -- UC016

System -- UC004
System -- UC005
System -- UC006
System -- UC009
System -- UC010
System -- UC016

UC003 .> UC002 : <<extend>>
UC013 .> UC003 : <<extend>>
UC010 .> UC002 : <<include>>
UC016 .> UC010 : <<include>>

hide Guest
hide SA